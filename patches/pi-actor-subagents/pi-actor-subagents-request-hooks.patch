diff --git a/extensions/actor-subagents/policy-api.test.ts b/extensions/actor-subagents/policy-api.test.ts
new file mode 100644
index 0000000..9c9de1e
--- /dev/null
+++ b/extensions/actor-subagents/policy-api.test.ts
@@ -0,0 +1,44 @@
+/**
+ * Local patch (request-hooks, policyApi 3): the API surface other extensions copy. The declarations below are
+ * checked by the type check (node's test runner strips types); the tests check the run-time surface.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { ApiEvent, PolicyResult, RequestInfo, SubagentsApiV1 } from "./api.ts";
+
+const info: RequestInfo = { name: "c", model: "test/m", requestId: "r1", signal: new AbortController().signal };
+
+const accepted: PolicyResult = {
+	model: "test/m",
+	thinkingLevel: "low",
+	async beforeRequest(payload: unknown, i: RequestInfo) {
+		return i.requestId ? payload : undefined;
+	},
+	hookTimeoutMs: 1000,
+	afterResponse(r: { name: string; requestId: string; status: number; headers: Record<string, string> }) {
+		void r;
+	},
+	contextFiles: false,
+	systemPrompt: "lean",
+};
+
+const events: ApiEvent[] = [
+	{ type: "tool_result", name: "c", requestId: "r1", toolName: "bash", isError: false, command: "ls" },
+	{ type: "tool_result", name: "c", requestId: "r1", toolName: "read", isError: true, path: "a.ts" },
+	{ type: "usage", name: "c", requestId: "r1", input: 1, cacheRead: 2, cacheWrite: 3, output: 4 },
+	{ type: "hook", name: "c", requestId: "r1", outcome: "timeout", waitedMs: 5 },
+];
+
+const v3: Pick<SubagentsApiV1, "policyApi"> = { policyApi: 3 };
+
+test("the API-3 declarations: a request-hook policy, the new events, policyApi", async () => {
+	assert.ok(!("reject" in accepted));
+	if ("reject" in accepted) return;
+	const payload = { model: "m" };
+	assert.equal(await accepted.beforeRequest?.(payload, info), payload);
+	assert.deepEqual(
+		events.map((e) => e.type),
+		["tool_result", "tool_result", "usage", "hook"],
+	);
+	assert.equal(v3.policyApi, 3);
+});
