+/** A summary link that records its calls. */
+function recordedLink() {
+	const calls: unknown[][] = [];
+	return {
+		calls,
+		link: {
+			begin: (signal?: AbortSignal) => void calls.push(["begin", signal]),
+			end: (usage?: unknown) => void calls.push(["end", usage]),
+		},
+	};
