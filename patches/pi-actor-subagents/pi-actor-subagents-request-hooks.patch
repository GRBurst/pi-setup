+/**
+ * Local patch (request-hooks, policyApi 3): the request hooks a spawn policy gives a child. SDK-free: pi's objects
+ * are reached through minimal local shapes, so pi's type drift between releases cannot reach this file.
+ */
+import type { ApiEvent, PolicyResult, RequestInfo } from "./api.ts";
+
+type Accept = Exclude<PolicyResult, { reject: string }>;
+export type RequestHooks = Pick<Accept, "beforeRequest" | "afterResponse" | "hookTimeoutMs">;
+export type HookOutcome = "timeout" | "error" | "aborted";
+export type Clock = { now(): number; setTimer(fn: () => void, ms: number): () => void };
+export const DEFAULT_HOOK_TIMEOUT_MS = 600_000;
+/** Node's largest timer delay; it turns a longer one into 1 ms (an immediate timeout). */
+export const MAX_TIMER_MS = 2_147_483_647;
+export const hookTimeout = (ms: number | undefined) =>
+	typeof ms === "number" && Number.isFinite(ms) && ms > 0 ? Math.min(ms, MAX_TIMER_MS) : DEFAULT_HOOK_TIMEOUT_MS;
+
+/** The child's held requests; the actor's own stops abort them. */
+export class HeldRequests {
+	private readonly live = new Set<AbortController>();
+	private closed = false;
+	hold(): { controller: AbortController; release(): void } {
+		const controller = new AbortController();
+		if (this.closed) controller.abort("aborted");
+		else this.live.add(controller);
+		return { controller, release: () => void this.live.delete(controller) };
+	}
+	abortAll(): void {
+		for (const c of [...this.live]) c.abort("aborted");
+	}
+	/** At shutdown: abort the held requests and every later one at once. */
+	close(): void {
+		this.closed = true;
+		this.abortAll();
+	}
+}
+
+/** Await the policy's hook for one request. Never rejects; never waits for the hook after an abort or the timeout. */
+export async function holdRequest(
+	payload: unknown,
+	info: Omit<RequestInfo, "signal">,
+	hooks: RequestHooks,
+	held: HeldRequests,
+	outer: AbortSignal | undefined,
+	clock: Clock,
+): Promise<{ payload: unknown; outcome?: HookOutcome; waitedMs: number }> {
+	const hook = hooks.beforeRequest;
+	if (!hook) return { payload, waitedMs: 0 };
+	const start = clock.now();
+	const done = (outcome?: HookOutcome, p: unknown = payload) => ({ payload: p, outcome, waitedMs: clock.now() - start });
+	const { controller: ac, release } = held.hold();
+	const onOuter = () => ac.abort("aborted");
+	if (outer?.aborted) onOuter();
+	else outer?.addEventListener("abort", onOuter, { once: true });
+	const cancel = clock.setTimer(() => ac.abort("timeout"), hookTimeout(hooks.hookTimeoutMs));
+	try {
+		if (ac.signal.aborted) return done(ac.signal.reason === "timeout" ? "timeout" : "aborted");
+		const stopped = new Promise<HookOutcome>((r) =>
+			ac.signal.addEventListener("abort", () => r(ac.signal.reason === "timeout" ? "timeout" : "aborted"), { once: true }),
+		);
+		const call = (async () => hook.call(hooks, payload, { ...info, signal: ac.signal }))().then(
+			(p) => ({ ok: true as const, p }),
+			() => ({ ok: false as const }),
+		);
+		const r = await Promise.race([call, stopped]);
+		if (typeof r === "string") return done(r);
+		return r.ok ? done(undefined, r.p === undefined ? payload : r.p) : done("error");
+	} finally {
+		cancel();
+		outer?.removeEventListener("abort", onOuter);
+		release();
+	}
+}
+
+/**
+ * The managed session's stops. Pause and kill: pi's abort first, then the held requests, WITHOUT awaiting pi's abort
+ * in between (`session.abort()` waits for idle, which a held hook blocks). Shutdown: close first, so a request held
+ * later is aborted at once.
+ */
+export function managedStops(
+	session: { abort(): Promise<void> },
+	held: HeldRequests,
+	shutdown: () => Promise<void>,
+): { abort(): Promise<void>; shutdown(): Promise<void> } {
+	return {
+		abort: () => {
+			const p = session.abort();
+			held.abortAll();
+			return p;
+		},
+		shutdown: async () => {
+			held.close();
+			await shutdown();
+		},
+	};
+}
+
+type PiLike = { on(event: string, h: (e: any, ctx: any) => unknown): void };
+type Usage = { input?: number; cacheRead?: number; cacheWrite?: number; output?: number };
+export type RequestHookDeps = {
+	name: string;
+	model: () => string;
+	hooks: RequestHooks | undefined;
+	held: HeldRequests;
+	emit: (e: ApiEvent) => void;
+	newId: () => string;
+	clock: Clock;
+};
+
+/** One inline child extension: request ids, the hold, the response callback, the usage, tool_result and hook events. */
+export function requestHookExtension(d: RequestHookDeps): {
+	extensions: { name: string; factory: (pi: PiLike) => void }[];
+} {
+	// an emit failure (a missing `emit` on an older API object, a throwing listener) never reaches pi
+	let current: string | undefined; // the latest provider request: afterResponse, usage
+	let issuedBy: string | undefined; // the id at the last assistant message_end: the one tool_result carries
+	let open = false; // current has had no usage yet
+	const emit = (e: ApiEvent) => {
+		try {
+			d.emit(e);
+		} catch {
+			// contained
+		}
+	};
+	const num = (u: Usage | undefined) => ({
+		input: u?.input ?? 0,
+		cacheRead: u?.cacheRead ?? 0,
+		cacheWrite: u?.cacheWrite ?? 0,
+		output: u?.output ?? 0,
+	});
+	const endOpen = (u?: Usage) => {
+		if (open && current) emit({ type: "usage", name: d.name, requestId: current, ...num(u) });
+		open = false;
+	};
+	// a transport without before_provider_request: the id is issued at the response
+	const id = () => {
+		if (!current || !open) {
+			current = d.newId();
+			open = true;
+		}
+		return current;
+	};
+	const factory = (pi: PiLike) => {
+		pi.on("before_provider_request", async (e, ctx) => {
+			let requestId: string | undefined;
+			// `ctx.signal` and `ctx.model` throw once the runner is inactive; pi would then send the payload with no
+			// `hook` event
+			try {
+				endOpen();
+				requestId = current = d.newId();
+				open = true;
+				if (!d.hooks?.beforeRequest) return undefined;
+				// ctx.signal is undefined outside a turn (a summary request): the actor's stops abort it
+				const model = ctx?.model ? `${ctx.model.provider}/${ctx.model.id}` : d.model();
+				const r = await holdRequest(e.payload, { name: d.name, model, requestId }, d.hooks, d.held, ctx?.signal, d.clock);
+				if (r.outcome) emit({ type: "hook", name: d.name, requestId, outcome: r.outcome, waitedMs: r.waitedMs });
+				return r.payload;
+			} catch {
+				if (requestId) emit({ type: "hook", name: d.name, requestId, outcome: "error", waitedMs: 0 });
+				return undefined; // payload unchanged
+			}
+		});
+		// pi >= 1.6.1: once per HTTP response, error responses and retried attempts included; the id stays the same
+		pi.on("after_provider_response", (e) => {
+			const requestId = id();
+			try {
+				d.hooks?.afterResponse?.({ name: d.name, requestId, status: e?.status, headers: e?.headers });
+			} catch {
+				// contained
+			}
+		});
+		// a chained transformation in pi >= 1.6: return nothing, change nothing
+		pi.on("message_end", (e) => {
+			const m = e?.message;
+			if (m?.role !== "assistant") return undefined;
+			const requestId = id();
+			emit({ type: "usage", name: d.name, requestId, ...num(m.usage) });
+			open = false;
+			issuedBy = requestId;
+			return undefined;
+		});
+		pi.on("agent_end", () => endOpen());
+		// a warm between runs (cacheWarming "idle") opens an id no agent_end follows; a stop must still end it
+		pi.on("session_shutdown", () => endOpen());
+		pi.on("tool_result", (e) => {
+			if (e?.parentToolCallId !== undefined) return undefined; // a nested call: not model-issued
+			const i = (e?.input ?? {}) as Record<string, unknown>;
+			emit({
+				type: "tool_result",
+				name: d.name,
+				requestId: issuedBy ?? id(),
+				toolName: e?.toolName,
+				isError: e?.isError === true,
+				...(typeof i.command === "string" ? { command: i.command } : {}),
+				...(typeof i.path === "string" ? { path: i.path } : {}),
+			});
+			return undefined;
+		});
+	};
+	return { extensions: [{ name: "subagent-request-hooks", factory }] };
+}
