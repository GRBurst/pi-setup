+			seen.push(i);
+			return out;
+		},
+	});
+	assert.equal(r.payload, out);
+	assert.equal(r.outcome, undefined);
+	assert.equal(seen.length, 1);
+	assert.deepEqual({ ...seen[0], signal: undefined }, { ...info, signal: undefined });
+	assert.ok(seen[0].signal instanceof AbortSignal);
+});
+
+test("a hook resolving undefined keeps the payload, same reference", async () => {
