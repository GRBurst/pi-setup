+/** A clock whose time and timers the test drives. */
+function fakeClock() {
+	let t = 1000;
+	const timers: { fn: () => void; ms: number; cancelled: boolean }[] = [];
+	const clock: Clock = {
+		now: () => t,
+		setTimer(fn, ms) {
+			const timer = { fn, ms, cancelled: false };
+			timers.push(timer);
+			return () => {
+				timer.cancelled = true;
+			};
+		},
+	};
+	return {
+		clock,
+		timers,
+		advance(ms: number) {
+			t += ms;
+		},
+		fire() {
+			for (const timer of timers) if (!timer.cancelled) timer.fn();
+		},
+	};
+}
+
+const info = { name: "c", model: "test/m", requestId: "r1" };
+const hold = (payload: unknown, hooks: RequestHooks, outer?: AbortSignal, c = fakeClock(), held = new HeldRequests()) =>
+	holdRequest(payload, info, hooks, held, outer, c.clock);
