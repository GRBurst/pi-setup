@@ -0,0 +1,236 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { createServer, type IncomingHttpHeaders } from "node:http";
+import type { AddressInfo } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test, type TestContext } from "node:test";
+import {
+	createAgentSession,
+	DefaultResourceLoader,
+	ModelRuntime,
+	SessionManager,
+	SettingsManager,
+} from "@earendil-works/pi-coding-agent";
+import type { ApiEvent } from "./api.ts";
+import { bindHeadlessExtensions } from "./bind-headless-extensions.ts";
+import {
+	type Clock,
+	HeldRequests,
+	hookSummaryStream,
+	managedStops,
+	requestHookExtension,
+	type RequestHooks,
+} from "./request-hooks.ts";
+
+// Local patch (request-hooks): the request-hook extension inside a real SDK child session (the pi of the npm lock),
+// against an openai-completions provider on localhost. Offline: the fake answers every request with one streamed
+// reply whose usage grows with the request's number (n-th request: 100·n input, n output tokens).
+
+type Seen = { body: Record<string, unknown>; headers: IncomingHttpHeaders };
+
+async function fakeProvider(t: TestContext): Promise<{ seen: Seen[]; url: string }> {
+	const seen: Seen[] = [];
+	const server = createServer((req, res) => {
+		let body = "";
+		req.on("data", (c) => {
+			body += c;
+		});
+		req.on("end", () => {
+			seen.push({ body: JSON.parse(body), headers: req.headers });
+			const n = seen.length;
+			const chunk = (o: unknown) => res.write(`data: ${JSON.stringify(o)}\n\n`);
+			const base = { id: "c", object: "chat.completion.chunk", created: 0, model: "m" };
+			res.writeHead(200, { "content-type": "text/event-stream" });
+			chunk({ ...base, choices: [{ index: 0, delta: { role: "assistant", content: `reply ${n}` }, finish_reason: null }] });
+			chunk({
+				...base,
+				choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+				usage: { prompt_tokens: 100 * n, completion_tokens: n, total_tokens: 101 * n },
+			});
+			res.end("data: [DONE]\n\n");
+		});
+	});
+	await new Promise<void>((r) => server.listen(0, "127.0.0.1", r));
+	t.after(() => {
+		server.closeAllConnections();
+		server.close();
+	});
+	return { seen, url: `http://127.0.0.1:${(server.address() as AddressInfo).port}/v1` };
+}
+
+const clock: Clock = {
+	now: () => Date.now(),
+	setTimer: (fn, ms) => {
+		const h = setTimeout(fn, ms);
+		return () => clearTimeout(h);
+	},
+};
+
+/** A child session as index.ts builds it, with the request-hook extension and a fake provider. */
+async function child(t: TestContext, hooks: RequestHooks | undefined) {
+	const provider = await fakeProvider(t);
+	const dir = mkdtempSync(join(tmpdir(), "pi-request-hooks-sdk-"));
+	t.after(() => rmSync(dir, { recursive: true, force: true }));
+	writeFileSync(
+		join(dir, "models.json"),
+		JSON.stringify({
+			providers: { probe: { baseUrl: provider.url, api: "openai-completions", apiKey: "probe-key", models: [{ id: "m" }] } },
+		}),
+	);
+	const modelRuntime = await ModelRuntime.create({
+		authPath: join(dir, "auth.json"),
+		modelsPath: join(dir, "models.json"),
+		allowModelNetwork: false,
+	});
+	const model = modelRuntime.getModel("probe", "m");
+	assert.ok(model, "the fake provider's model is not in the model runtime");
+	const events: ApiEvent[] = [];
+	const held = new HeldRequests();
+	let n = 0;
+	const hooked = requestHookExtension({
+		name: "c",
+		model: () => "probe/m",
+		hooks,
+		held,
+		emit: (e) => events.push(e),
+		newId: () => `r${++n}`,
+		clock,
+	});
+	// keepRecentTokens 1: two short turns are enough for session.compact() to summarize the first
+	const settingsManager = SettingsManager.inMemory({ compaction: { keepRecentTokens: 1 } });
