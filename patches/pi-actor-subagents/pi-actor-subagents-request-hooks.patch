diff --git a/extensions/actor-subagents/lean-child.test.ts b/extensions/actor-subagents/lean-child.test.ts
new file mode 100644
index 0000000..5df042b
--- /dev/null
+++ b/extensions/actor-subagents/lean-child.test.ts
@@ -0,0 +1,33 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { DefaultResourceLoader, SettingsManager } from "@earendil-works/pi-coding-agent";
+import { childContextOptions } from "./child-prompt.ts";
+
+// Local patch (request-hooks): a policy's contextFiles: false starts the child without AGENTS.md/CLAUDE.md.
+
+test("contextFiles false asks the loader for no context files; undefined asks nothing", () => {
+	assert.deepEqual(childContextOptions(false), { noContextFiles: true });
+	assert.deepEqual(childContextOptions(undefined), {});
+});
+
+test("pi's resource loader drops the project's AGENTS.md under childContextOptions(false)", async (t) => {
+	const dir = mkdtempSync(join(tmpdir(), "pi-lean-child-"));
+	t.after(() => rmSync(dir, { recursive: true, force: true }));
+	writeFileSync(join(dir, "AGENTS.md"), "# project rules\n");
+	const load = async (contextFiles: false | undefined) => {
+		const loader = new DefaultResourceLoader({
+			cwd: dir,
+			agentDir: dir,
+			settingsManager: SettingsManager.inMemory({}),
+			noExtensions: true,
+			...childContextOptions(contextFiles),
+		});
+		await loader.reload();
+		return loader.getAgentsFiles().agentsFiles.map((f) => f.path);
+	};
+	assert.deepEqual(await load(undefined), [join(dir, "AGENTS.md")], "control: the loader did not find AGENTS.md");
+	assert.deepEqual(await load(false), []);
+});
diff --git a/extensions/actor-subagents/policy-api.test.ts b/extensions/actor-subagents/policy-api.test.ts
new file mode 100644
index 0000000..011bd6e
--- /dev/null
+++ b/extensions/actor-subagents/policy-api.test.ts
@@ -0,0 +1,96 @@
+/**
+ * Local patch (request-hooks, policyApi 3): the API surface other extensions copy. The declarations below are
+ * checked by the type check (node's test runner strips types); the tests check the run-time surface.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { installApi, type ApiEvent, type PolicyResult, type RequestInfo, type SubagentsApiV1 } from "./api.ts";
+import { Engine } from "./engine.ts";
+
+const info: RequestInfo = { name: "c", model: "test/m", requestId: "r1", signal: new AbortController().signal };
+
+const accepted: PolicyResult = {
+	model: "test/m",
+	thinkingLevel: "low",
+	async beforeRequest(payload: unknown, i: RequestInfo) {
+		return i.requestId ? payload : undefined;
+	},
+	hookTimeoutMs: 1000,
+	afterResponse(r: { name: string; requestId: string; status: number; headers: Record<string, string> }) {
+		void r;
+	},
+	contextFiles: false,
+	systemPrompt: "lean",
+};
+
+const events: ApiEvent[] = [
+	{ type: "tool_result", name: "c", requestId: "r1", toolName: "bash", isError: false, command: "ls" },
+	{ type: "tool_result", name: "c", requestId: "r1", toolName: "read", isError: true, path: "a.ts" },
+	{ type: "usage", name: "c", requestId: "r1", input: 1, cacheRead: 2, cacheWrite: 3, output: 4 },
+	{ type: "hook", name: "c", requestId: "r1", outcome: "timeout", waitedMs: 5 },
+];
+
+const v3: Pick<SubagentsApiV1, "policyApi"> = { policyApi: 3 };
+
+test("the API-3 declarations: a request-hook policy, the new events, policyApi", async () => {
+	assert.ok(!("reject" in accepted));
+	if ("reject" in accepted) return;
+	const payload = { model: "m" };
+	assert.equal(await accepted.beforeRequest?.(payload, info), payload);
+	assert.deepEqual(
+		events.map((e) => e.type),
+		["tool_result", "tool_result", "usage", "hook"],
+	);
+	assert.equal(v3.policyApi, 3);
+});
+
+const caps = { maxAgents: 8, maxSpawnDepth: 3 };
+const fresh = () => ({}) as Record<string, unknown>;
+const main = {
+	name: "main",
+	model: "test/m",
+	handle: { deliver: async () => {}, abort: async () => {} },
+	spawnedBy: "main",
+	depth: 0,
+	createdAt: 0,
+	turns: 0,
+	lastActivity: 0,
+};
+const usage: ApiEvent = { type: "usage", name: "c", requestId: "r1", input: 1, cacheRead: 0, cacheWrite: 0, output: 1 };
+
+test("emit: API-only events reach subscribers beside the engine's, survive a rebind, stop on unsubscribe", () => {
+	const g = fresh();
+	const engine = new Engine(caps);
+	const api = installApi({ engine, retune: async () => {} }, g);
+	const seen: string[] = [];
+	const off = api.subscribe((e) => seen.push(e.type));
+	engine.addAgent(main);
+	api.emit(usage);
+	installApi({ engine: new Engine(caps), retune: async () => {} }, g);
+	api.emit({ ...usage, requestId: "r2" });
+	off();
+	api.emit({ ...usage, requestId: "r3" });
+	engine.reportError("main", "after");
+	assert.deepEqual(seen, ["spawn", "usage", "usage"]);
+});
+
+test("emit: a throwing listener does not stop the next", () => {
+	const api = installApi({ engine: new Engine(caps), retune: async () => {} }, fresh());
+	const seen: string[] = [];
+	api.subscribe(() => {
+		throw new Error("listener");
+	});
+	api.subscribe((e) => seen.push(e.type));
+	api.emit(usage);
+	assert.deepEqual(seen, ["usage"]);
+});
+
+test("the installed API claims policyApi 3 and keeps it across a rebind", () => {
+	const g = fresh();
+	const api = installApi({ engine: new Engine(caps), retune: async () => {} }, g);
+	assert.equal(api.policyApi, 3);
+	assert.equal(api.version, 1);
+	assert.equal(g.__subagentsApi_v1, api);
+	installApi({ engine: new Engine(caps), retune: async () => {} }, g);
+	assert.equal((g.__subagentsApi_v1 as typeof api).policyApi, 3);
+});
