+/** The extension with a counter for ids, a recorded emit and a fake clock, loaded into a fake pi. */
+function loaded(over: Partial<RequestHookDeps> = {}) {
+	const events: ApiEvent[] = [];
+	let n = 0;
+	const c = fakeClock();
+	const held = new HeldRequests();
+	const deps: RequestHookDeps = {
+		name: "c",
+		model: () => "fallback/m",
+		hooks: undefined,
+		held,
+		emit: (e) => events.push(e),
+		newId: () => `r${++n}`,
+		clock: c.clock,
+		...over,
+	};
+	const ext = requestHookExtension(deps);
+	const pi = fakePi();
+	ext.extensions[0].factory(pi);
+	const request = async (payload: unknown = { p: 1 }, ctx: unknown = { model: { provider: "p", id: "m" } }) =>
+		(await pi.fire("before_provider_request", { type: "before_provider_request", payload }, ctx))[0];
+	return { ext, pi, events, held, clock: c, request };
