+/** A fake agent whose stream function records its options and returns a stream with a result the test settles. */
+function fakeAgent(over: { throws?: boolean; onPayload?: unknown } = {}) {
+	const P = "onPayload" in over ? over.onPayload : () => {};
+	const R = () => {};
+	const seen: any[] = [];
+	let settle!: { resolve(m: unknown): void; reject(e: unknown): void };
+	const result = new Promise((resolve, reject) => {
+		settle = { resolve, reject };
+	});
+	result.catch(() => {});
+	const stream = { result: () => result };
+	const orig = async (_model: unknown, _context: unknown, options?: any) => {
+		seen.push(options);
+		if (over.throws) throw new Error("stream failed");
+		return stream;
+	};
+	const agent: { streamFunction: typeof orig; onPayload?: unknown; onResponse?: unknown } = { streamFunction: orig, onPayload: P, onResponse: R };
+	return { agent, orig, seen, stream, settle, P, R };
