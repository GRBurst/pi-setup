@@ -0,0 +1,86 @@
+/**
+ * Local patch (request-hooks, policyApi 3): the API surface other extensions copy. The declarations below are
+ * checked by the type check (node's test runner strips types); the tests check the run-time surface.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { installApi, type ApiEvent, type PolicyResult, type RequestInfo, type SubagentsApiV1 } from "./api.ts";
+import { Engine } from "./engine.ts";
+
+const info: RequestInfo = { name: "c", model: "test/m", requestId: "r1", signal: new AbortController().signal };
+
+const accepted: PolicyResult = {
+	model: "test/m",
+	thinkingLevel: "low",
+	async beforeRequest(payload: unknown, i: RequestInfo) {
+		return i.requestId ? payload : undefined;
+	},
+	hookTimeoutMs: 1000,
+	afterResponse(r: { name: string; requestId: string; status: number; headers: Record<string, string> }) {
+		void r;
+	},
+	contextFiles: false,
+	systemPrompt: "lean",
+};
+
+const events: ApiEvent[] = [
+	{ type: "tool_result", name: "c", requestId: "r1", toolName: "bash", isError: false, command: "ls" },
+	{ type: "tool_result", name: "c", requestId: "r1", toolName: "read", isError: true, path: "a.ts" },
+	{ type: "usage", name: "c", requestId: "r1", input: 1, cacheRead: 2, cacheWrite: 3, output: 4 },
+	{ type: "hook", name: "c", requestId: "r1", outcome: "timeout", waitedMs: 5 },
+];
+
+const v3: Pick<SubagentsApiV1, "policyApi"> = { policyApi: 3 };
+
+test("the API-3 declarations: a request-hook policy, the new events, policyApi", async () => {
+	assert.ok(!("reject" in accepted));
+	if ("reject" in accepted) return;
+	const payload = { model: "m" };
+	assert.equal(await accepted.beforeRequest?.(payload, info), payload);
+	assert.deepEqual(
+		events.map((e) => e.type),
+		["tool_result", "tool_result", "usage", "hook"],
+	);
+	assert.equal(v3.policyApi, 3);
+});
+
+const caps = { maxAgents: 8, maxSpawnDepth: 3 };
+const fresh = () => ({}) as Record<string, unknown>;
+const main = {
+	name: "main",
+	model: "test/m",
+	handle: { deliver: async () => {}, abort: async () => {} },
+	spawnedBy: "main",
+	depth: 0,
+	createdAt: 0,
+	turns: 0,
+	lastActivity: 0,
+};
+const usage: ApiEvent = { type: "usage", name: "c", requestId: "r1", input: 1, cacheRead: 0, cacheWrite: 0, output: 1 };
+
+test("emit: API-only events reach subscribers beside the engine's, survive a rebind, stop on unsubscribe", () => {
+	const g = fresh();
+	const engine = new Engine(caps);
+	const api = installApi({ engine, retune: async () => {} }, g);
+	const seen: string[] = [];
+	const off = api.subscribe((e) => seen.push(e.type));
+	engine.addAgent(main);
+	api.emit(usage);
+	installApi({ engine: new Engine(caps), retune: async () => {} }, g);
+	api.emit({ ...usage, requestId: "r2" });
+	off();
+	api.emit({ ...usage, requestId: "r3" });
+	engine.reportError("main", "after");
+	assert.deepEqual(seen, ["spawn", "usage", "usage"]);
+});
+
+test("emit: a throwing listener does not stop the next", () => {
+	const api = installApi({ engine: new Engine(caps), retune: async () => {} }, fresh());
+	const seen: string[] = [];
+	api.subscribe(() => {
+		throw new Error("listener");
+	});
+	api.subscribe((e) => seen.push(e.type));
+	api.emit(usage);
+	assert.deepEqual(seen, ["usage"]);
+});
diff --git a/extensions/actor-subagents/request-hooks.test.ts b/extensions/actor-subagents/request-hooks.test.ts
new file mode 100644
index 0000000..d62cfe5
--- /dev/null
+++ b/extensions/actor-subagents/request-hooks.test.ts
@@ -0,0 +1,636 @@
+/** Local patch (request-hooks, policyApi 3): the request hooks a spawn policy gives a child. */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+	DEFAULT_HOOK_TIMEOUT_MS,
+	HeldRequests,
+	holdRequest,
+	managedStops,
+	MAX_TIMER_MS,
+	requestHookExtension,
+	type RequestHookDeps,
+	type Clock,
+	type RequestHooks,
+} from "./request-hooks.ts";
+import type { ApiEvent, RequestInfo } from "./api.ts";
+
+/** A clock whose time and timers the test drives. */
+function fakeClock() {
+	let t = 1000;
+	const timers: { fn: () => void; ms: number; cancelled: boolean }[] = [];
+	const clock: Clock = {
+		now: () => t,
+		setTimer(fn, ms) {
+			const timer = { fn, ms, cancelled: false };
+			timers.push(timer);
+			return () => {
+				timer.cancelled = true;
+			};
+		},
+	};
+	return {
+		clock,
+		timers,
+		advance(ms: number) {
+			t += ms;
+		},
+		fire() {
+			for (const timer of timers) if (!timer.cancelled) timer.fn();
+		},
+	};
+}
+
+const info = { name: "c", model: "test/m", requestId: "r1" };
+const hold = (payload: unknown, hooks: RequestHooks, outer?: AbortSignal, c = fakeClock(), held = new HeldRequests()) =>
+	holdRequest(payload, info, hooks, held, outer, c.clock);
+
+test("resolved hook: its payload is the one sent, with no outcome", async () => {
+	const seen: RequestInfo[] = [];
+	const out = { rewritten: true };
+	const r = await hold({ a: 1 }, {
+		async beforeRequest(_p, i) {
+			seen.push(i);
+			return out;
+		},
+	});
+	assert.equal(r.payload, out);
+	assert.equal(r.outcome, undefined);
+	assert.equal(seen.length, 1);
+	assert.deepEqual({ ...seen[0], signal: undefined }, { ...info, signal: undefined });
+	assert.ok(seen[0].signal instanceof AbortSignal);
+});
+
+test("a hook resolving undefined keeps the payload, same reference", async () => {
+	const payload = { a: 1 };
+	const r = await hold(payload, { beforeRequest: async () => undefined });
+	assert.equal(r.payload, payload);
+	assert.equal(r.outcome, undefined);
+});
+
+test("rejecting and throwing hooks: payload unchanged, outcome error", async () => {
+	const payload = { a: 1 };
+	const rejected = await hold(payload, { beforeRequest: async () => Promise.reject(new Error("no")) });
+	assert.equal(rejected.payload, payload);
+	assert.equal(rejected.outcome, "error");
+	const thrown = await hold(payload, {
+		beforeRequest: (() => {
+			throw new Error("sync");
+		}) as unknown as RequestHooks["beforeRequest"],
+	});
+	assert.equal(thrown.payload, payload);
+	assert.equal(thrown.outcome, "error");
+});
+
+test("no hook: nothing held, waitedMs 0", async () => {
+	const payload = { a: 1 };
+	const c = fakeClock();
+	const r = await hold(payload, {}, undefined, c);
+	assert.equal(r.payload, payload);
+	assert.equal(r.outcome, undefined);
+	assert.equal(r.waitedMs, 0);
+	assert.equal(c.timers.length, 0);
+});
+
+/** A hook the test settles, and the signal it was handed. */
+function pendingHook() {
+	let resolve!: (p: unknown) => void;
+	const calls: RequestInfo[] = [];
+	const hooks: RequestHooks = {
+		beforeRequest(_p, i) {
+			calls.push(i);
+			return new Promise((r) => {
+				resolve = r;
+			});
+		},
+	};
+	return { hooks, calls, resolve: (p: unknown) => resolve(p) };
+}
+
+test("timeout: the signal aborts with reason timeout, the payload proceeds as it was", async () => {
+	const c = fakeClock();
+	const h = pendingHook();
+	const payload = { a: 1 };
+	const p = hold(payload, { ...h.hooks, hookTimeoutMs: 1500 }, undefined, c);
+	assert.equal(c.timers.length, 1);
+	assert.equal(c.timers[0].ms, 1500);
+	await Promise.resolve();
+	c.advance(1500);
+	c.fire();
+	const r = await p;
+	assert.equal(r.outcome, "timeout");
+	assert.equal(r.payload, payload);
+	assert.equal(r.waitedMs, 1500);
+	assert.equal(h.calls[0].signal.aborted, true);
+	assert.equal(h.calls[0].signal.reason, "timeout");
+	// a late resolution changes nothing
+	h.resolve({ late: true });
+	assert.equal((await p).payload, payload);
+});
+
+test("default timeout: an absent or unusable hookTimeoutMs waits 600 000 ms", () => {
+	assert.equal(DEFAULT_HOOK_TIMEOUT_MS, 600_000);
+	for (const hookTimeoutMs of [undefined, 0, -1, Number.NaN, Number.POSITIVE_INFINITY]) {
+		const c = fakeClock();
+		void hold({}, { ...pendingHook().hooks, hookTimeoutMs }, undefined, c);
+		assert.equal(c.timers[0].ms, 600_000, `hookTimeoutMs ${hookTimeoutMs}`);
+	}
+});
+
+test("timeout cap: Node's largest timer delay, never a longer one (Node turns it into 1 ms)", () => {
+	assert.equal(MAX_TIMER_MS, 2_147_483_647);
+	for (const [hookTimeoutMs, ms] of [
+		[2_147_483_647, 2_147_483_647],
+		[2_147_483_648, 2_147_483_647],
+		[Number.MAX_SAFE_INTEGER, 2_147_483_647],
+		[1500, 1500],
+	]) {
+		const c = fakeClock();
+		void hold({}, { ...pendingHook().hooks, hookTimeoutMs }, undefined, c);
+		assert.equal(c.timers[0].ms, ms, `hookTimeoutMs ${hookTimeoutMs}`);
+	}
+});
+
+test("a resolved hook cancels its timer", async () => {
+	const c = fakeClock();
+	const r = await hold({}, { beforeRequest: async () => ({ b: 2 }) }, undefined, c);
+	assert.deepEqual(r.payload, { b: 2 });
+	assert.equal(c.timers.length, 1);
+	assert.equal(c.timers[0].cancelled, true);
+});
+
+/** p settles before the next macrotask, or the test fails with "did not settle". */
+const settles = <T>(p: Promise<T>) =>
+	Promise.race([p, new Promise<never>((_, reject) => setImmediate(() => reject(new Error("did not settle"))))]);
+const never: RequestHooks = { beforeRequest: () => new Promise(() => {}) };
+
+test("abortAll settles a never-settling hook: outcome aborted, timer cancelled", async () => {
+	const c = fakeClock();
+	const held = new HeldRequests();
+	const h = pendingHook();
+	const payload = { a: 1 };
+	const p = hold(payload, h.hooks, undefined, c, held);
+	await Promise.resolve();
+	held.abortAll();
+	const r = await settles(p);
+	assert.equal(r.outcome, "aborted");
+	assert.equal(r.payload, payload);
+	assert.equal(h.calls[0].signal.reason, "aborted");
+	assert.equal(c.timers[0].cancelled, true);
+});
+
+test("outer signal aborts: pi's own abort releases the hold", async () => {
+	const outer = new AbortController();
+	const h = pendingHook();
+	const p = hold({}, h.hooks, outer.signal);
+	await Promise.resolve();
+	outer.abort();
+	const r = await settles(p);
+	assert.equal(r.outcome, "aborted");
+	assert.equal(h.calls[0].signal.reason, "aborted");
+});
+
+test("an outer signal aborted already: the hook is not called", async () => {
+	const outer = new AbortController();
+	outer.abort();
+	const h = pendingHook();
+	const r = await settles(hold({}, h.hooks, outer.signal));
+	assert.equal(r.outcome, "aborted");
+	assert.equal(h.calls.length, 0);
+});
+
+test("no outer signal (a summary request): only the actor's stops or the timeout release it", async () => {
+	const held = new HeldRequests();
+	let settled = false;
+	const p = hold({}, never, undefined, fakeClock(), held).then((r) => {
+		settled = true;
+		return r;
+	});
+	await new Promise((r) => setImmediate(r));
+	assert.equal(settled, false);
+	held.abortAll();
+	assert.equal((await settles(p)).outcome, "aborted");
+});
+
+test("close aborts held and later holds", async () => {
+	const held = new HeldRequests();
+	const p = hold({}, never, undefined, fakeClock(), held);
+	await Promise.resolve();
+	held.close();
+	assert.equal((await settles(p)).outcome, "aborted");
+	const h = pendingHook();
+	const later = await settles(hold({}, h.hooks, undefined, fakeClock(), held));
+	assert.equal(later.outcome, "aborted");
+	assert.equal(h.calls.length, 0);
+});
+
+/** held with its abortAll and close calls logged. */
+function loggedHeld(log: string[]) {
+	const held = new HeldRequests();
+	const abortAll = held.abortAll.bind(held);
+	const close = held.close.bind(held);
+	held.abortAll = () => {
+		log.push("abortAll");
+		abortAll();
+	};
+	held.close = () => {
+		log.push("close");
+		close();
+	};
+	return held;
+}
+
+test("managedStops: abort calls pi's abort, then aborts the held requests without awaiting it", async () => {
+	const log: string[] = [];
+	const held = loggedHeld(log);
+	const { controller } = held.hold();
+	let piAbort!: Promise<void>;
+	// pi's abort waits for idle, which a held request blocks: it settles only once the hold is released
+	const session = {
+		abort() {
+			log.push("session.abort");
+			piAbort = new Promise<void>((r) => controller.signal.addEventListener("abort", () => r(), { once: true }));
+			return piAbort;
+		},
+	};
+	const stops = managedStops(session, held, async () => {
+		log.push("body");
+	});
+	const p = stops.abort();
+	await settles(p);
+	assert.equal(p, piAbort);
+	assert.deepEqual(log, ["session.abort", "abortAll"]);
+});
+
+test("managedStops: shutdown closes the held requests before the shutdown body", async () => {
+	const log: string[] = [];
+	const held = loggedHeld(log);
+	const stops = managedStops({ abort: async () => {} }, held, async () => {
+		log.push("body");
+	});
+	await stops.shutdown();
+	assert.deepEqual(log, ["close", "abortAll", "body"]);
+	assert.equal(held.hold().controller.signal.aborted, true);
+});
+
+test("managedStops: a throwing shutdown body still leaves the held requests closed", async () => {
+	const held = new HeldRequests();
+	const stops = managedStops({ abort: async () => {} }, held, async () => {
+		throw new Error("body");
+	});
+	await assert.rejects(stops.shutdown(), /body/);
+	assert.equal(held.hold().controller.signal.aborted, true);
+});
+
+/** pi's extension registry as far as the request-hook extension uses it. */
+function fakePi() {
+	const handlers = new Map<string, ((e: any, ctx: any) => unknown)[]>();
+	return {
+		handlers,
+		on(event: string, h: (e: any, ctx: any) => unknown) {
+			handlers.set(event, [...(handlers.get(event) ?? []), h]);
+		},
+		/** Runs the event's handlers in order; resolves with their results. */
+		async fire(event: string, e: unknown = {}, ctx: unknown = {}) {
+			const out: unknown[] = [];
+			for (const h of handlers.get(event) ?? []) out.push(await h(e, ctx));
+			return out;
+		},
+	};
+}
+
+/** The extension with a counter for ids, a recorded emit and a fake clock, loaded into a fake pi. */
+function loaded(over: Partial<RequestHookDeps> = {}) {
+	const events: ApiEvent[] = [];
+	let n = 0;
+	const c = fakeClock();
+	const held = new HeldRequests();
+	const deps: RequestHookDeps = {
+		name: "c",
+		model: () => "fallback/m",
+		hooks: undefined,
+		held,
+		emit: (e) => events.push(e),
+		newId: () => `r${++n}`,
+		clock: c.clock,
+		...over,
+	};
+	const ext = requestHookExtension(deps);
+	const pi = fakePi();
+	ext.extensions[0].factory(pi);
+	const request = async (payload: unknown = { p: 1 }, ctx: unknown = { model: { provider: "p", id: "m" } }) =>
+		(await pi.fire("before_provider_request", { type: "before_provider_request", payload }, ctx))[0];
+	return { ext, pi, events, held, clock: c, request };
+}
+
+test("ids are distinct: every request hands beforeRequest a new id, name, model and signal", async () => {
+	for (let n = 1; n <= 20; n++) {
+		const seen: RequestInfo[] = [];
+		const x = loaded({
+			hooks: {
+				async beforeRequest(p, i) {
+					seen.push(i);
+					return { ...(p as object), hooked: i.requestId };
+				},
+			},
+		});
+		const sent: unknown[] = [];
+		for (let k = 0; k < n; k++) sent.push(await x.request({ k }, k % 2 ? {} : { model: { provider: "p", id: "m" } }));
+		const ids = seen.map((i) => i.requestId);
