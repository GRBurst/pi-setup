+/**
+ * Local patch (request-hooks, policyApi 3): the request hooks a spawn policy gives a child. SDK-free: pi's objects
+ * are reached through minimal local shapes, so pi's type drift between releases cannot reach this file.
+ */
+import type { PolicyResult, RequestInfo } from "./api.ts";
+
+type Accept = Exclude<PolicyResult, { reject: string }>;
+export type RequestHooks = Pick<Accept, "beforeRequest" | "afterResponse" | "hookTimeoutMs">;
+export type HookOutcome = "timeout" | "error" | "aborted";
+export type Clock = { now(): number; setTimer(fn: () => void, ms: number): () => void };
+
+/** The child's held requests; the actor's own stops abort them. */
+export class HeldRequests {
+	private readonly live = new Set<AbortController>();
+	hold(): { controller: AbortController; release(): void } {
+		const controller = new AbortController();
+		this.live.add(controller);
+		return { controller, release: () => void this.live.delete(controller) };
+	}
+}
+
+/** Await the policy's hook for one request. Never rejects. */
+export async function holdRequest(
+	payload: unknown,
+	info: Omit<RequestInfo, "signal">,
+	hooks: RequestHooks,
+	held: HeldRequests,
+	_outer: AbortSignal | undefined,
+	clock: Clock,
+): Promise<{ payload: unknown; outcome?: HookOutcome; waitedMs: number }> {
+	const hook = hooks.beforeRequest;
+	if (!hook) return { payload, waitedMs: 0 };
+	const start = clock.now();
+	const done = (outcome?: HookOutcome, p: unknown = payload) => ({ payload: p, outcome, waitedMs: clock.now() - start });
+	const { controller: ac, release } = held.hold();
+	try {
+		const r = await (async () => hook.call(hooks, payload, { ...info, signal: ac.signal }))().then(
+			(p) => ({ ok: true as const, p }),
+			() => ({ ok: false as const }),
+		);
+		return r.ok ? done(undefined, r.p === undefined ? payload : r.p) : done("error");
+	} finally {
+		release();
+	}
+}
