+/** pi's extension registry as far as the request-hook extension uses it. */
+function fakePi() {
+	const handlers = new Map<string, ((e: any, ctx: any) => unknown)[]>();
+	return {
+		handlers,
+		on(event: string, h: (e: any, ctx: any) => unknown) {
+			handlers.set(event, [...(handlers.get(event) ?? []), h]);
+		},
+		/** Runs the event's handlers in order; resolves with their results. */
+		async fire(event: string, e: unknown = {}, ctx: unknown = {}) {
+			const out: unknown[] = [];
+			for (const h of handlers.get(event) ?? []) out.push(await h(e, ctx));
+			return out;
+		},
+	};
+}
